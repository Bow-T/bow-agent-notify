<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Trạng thái" (viên thuốc 2×1): đang có mấy việc chờ. Chạm là mở app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp">

    <ImageView
        android:id="@+id/status_icon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:importantForAccessibility="no"
        android:src="@drawable/w_logo_mark" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/status_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/widget_preview_status"
            android:textColor="@color/widget_ink"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/widget_preview_status_sub"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
