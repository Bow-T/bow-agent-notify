<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Xác thực vân tay / khuôn mặt trước khi cho phép một thao tác rủi ro từ điện thoại. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Cập nhật trong app: đưa APK bản mới (tải từ GitHub Releases) cho trình cài đặt của máy. Quyền này chỉ cho
         app MỞ hộp cài đặt — Android vẫn hỏi người dùng từng lần, và lần đầu còn phải bật "cho phép từ nguồn này". -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application
        android:label="Bow Notify"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Chạm vào widget màn hình chính để mở app. -->
            <intent-filter>
                <action android:name="es.antonborri.home_widget.action.LAUNCH" />
            </intent-filter>
        </activity>
        <!-- Nút Cho phép / Từ chối trên thông báo: gói flutter_local_notifications nhận cú bấm qua receiver này rồi gọi
             về Dart (notifications.dart) — kể cả khi app đã tắt. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"
            android:exported="false" />
        <!-- Kết quả của trình cài đặt khi cập nhật app (AppUpdate.kt). KHÔNG exported: app khác không giả được
             "cần xác nhận" để bắt app này mở một màn hình tuỳ ý. -->
        <receiver
            android:name=".InstallStatusReceiver"
            android:exported="false" />
        <!-- Widget màn hình chính (BowWidgets.kt). -->
        <receiver
            android:name=".PendingWidgetProvider"
            android:exported="true"
            android:label="@string/widget_pending_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_pending_info" />
        </receiver>
        <receiver
            android:name=".StatusWidgetProvider"
            android:exported="true"
            android:label="@string/widget_status_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_status_info" />
        </receiver>
        <!-- Cú chạm vào nút của widget → Dart (isolate nền). KHÔNG exported: chỉ PendingIntent do chính app tạo mới tới
             được đây — app khác không gửi được "cho phép" giả vào receiver này. -->
        <receiver
            android:name="es.antonborri.home_widget.HomeWidgetBackgroundReceiver"
            android:exported="false" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Thông báo FCM tới lúc app chạy nền / đã tắt do hệ điều hành tự dựng từ ba thứ dưới đây. Server gửi kèm
             channel_id theo loại (bow_ask / bow_done / bow_fail — MainActivity tạo); thiếu thì rơi về kênh mặc định. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="bow_ask" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_bow" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/bow_accent" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
